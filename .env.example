# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=opensoul
POSTGRES_PASSWORD=opensoul
POSTGRES_DB=opensoul
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opensoul:opensoul@localhost:5432/opensoul

# ── Qdrant ──────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opensoul_knowledge

# ── Meilisearch ─────────────────────────────────────────
MEILI_MASTER_KEY=opensoul_master_key
MEILI_PORT=7700
MEILI_URL=http://localhost:7700
MEILI_KEY=opensoul_master_key
MEILI_INDEX=opensoul_knowledge

# ── Redis ───────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM ─────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Embedding ───────────────────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── NATS ────────────────────────────────────────────────
# NATS_URL=nats://localhost:4222

# ── Alert ───────────────────────────────────────────────
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
